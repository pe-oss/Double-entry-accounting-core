# Sao chép file này thành ".env" rồi điền giá trị thật. KHÔNG commit file .env.

# --- Google / Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# --- PostgreSQL (dùng bởi docker/docker-compose.yml) ---
POSTGRES_DB=accounting_core
POSTGRES_USER=acc_admin
POSTGRES_PASSWORD=acc_secure_password_2026
POSTGRES_PORT=5432

# --- Chuỗi kết nối cho ứng dụng / Alembic ---
DATABASE_URL=postgresql://acc_admin:acc_secure_password_2026@localhost:5432/accounting_core
