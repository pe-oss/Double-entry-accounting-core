# Sao chép file này thành ".env" rồi điền giá trị thật. KHÔNG commit file .env.

# --- Google / Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# --- PostgreSQL (dùng bởi docker/docker-compose.yml) ---
POSTGRES_USER=ketoan_admin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=ketoan_core
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ketoan_admin:change_me_strong_password@localhost:5432/ketoan_core
